{
  "policies": [
    {
      "name": "broker_admin",
      "permissions": ["users.read", "users.invite", "users.status.write", "policies.read", "integrations.read", "audit.read"]
    },
    {
      "name": "operations",
      "permissions": ["users.read", "users.invite", "integrations.read"]
    },
    {
      "name": "viewer",
      "permissions": ["users.read"]
    }
  ],
  "defaultDecision": "deny",
  "scopeClaim": "broker_id",
  "issuer": "Auth0",
  "notes": "The API must enforce broker scope server-side; UI visibility is not authorization."
}
